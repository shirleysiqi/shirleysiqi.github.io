---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../config';
---
<BaseLayout title="Contact | Siqi Chen">
<section class="page-hero"><div class="wide-container"><p class="eyebrow" data-en="CONNECT" data-zh="联系">CONNECT</p><h1 data-en="Let's Connect" data-zh="保持联系">Let's Connect</h1><p data-en="Open to professional conversations around corporate communications, financial PR, media relations, branding and stakeholder engagement." data-zh="欢迎围绕企业传讯、财经公关、媒体关系、品牌与持份者沟通进行专业交流。">Open to professional conversations around corporate communications, financial PR, media relations, branding and stakeholder engagement.</p></div></section>
<section class="wide-container contact-grid"><div class="contact-card"><span>Email</span><a href={`mailto:${profile.email}`}>{profile.email}</a></div><div class="contact-card"><span>LinkedIn</span><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn Profile →</a><small data-en="Replace placeholder URL in src/config.ts before publishing." data-zh="正式发布前请在 src/config.ts 中替换为你的真实LinkedIn链接。">Replace placeholder URL in src/config.ts before publishing.</small></div><div class="contact-card"><span data-en="Location" data-zh="所在地">Location</span><strong>Hong Kong</strong></div></section>
</BaseLayout>
