---
import BaseLayout from '../layouts/BaseLayout.astro';
const groups = [
 ['Corporate Communications','企业传讯',['Corporate Messaging','Bilingual Communications','Press Releases','Corporate Publications','Corporate Website']],
 ['Financial PR & IR','财经公关与投资者关系',['Listed-company Communications','Investor Relations Support','Financial PR','Market Communications','Corporate Events']],
 ['Media Relations','媒体关系',['Media Engagement','Media Pitching','Interviews','Media Monitoring','Public Opinion Monitoring']],
 ['Stakeholder Engagement','持份者沟通',['Public Consultation','Public Enquiries','Community Relations','Issue Management','Crisis Communications']],
 ['Brand & Digital','品牌与数字传播',['Brand Management','Social Media','Digital Content','Corporate Identity','Corporate Collateral']],
 ['ESG & Events','ESG与活动',['ESG Communications','Corporate Events','Press Conferences','Networking Events','Stakeholder Programmes']]
];
---
<BaseLayout title="Expertise | Siqi Chen">
  <section class="page-hero"><div class="wide-container"><p class="eyebrow" data-en="CAPABILITY MAP" data-zh="能力地图">CAPABILITY MAP</p><h1 data-en="Expertise" data-zh="专业能力">Expertise</h1><p data-en="A communications skill set shaped by agency-side financial PR, stakeholder-facing public relations and in-house corporate communications." data-zh="能力体系来自财经公关代理、公共及持份者关系，以及金融机构企业传讯三类实战环境。">A communications skill set shaped by agency-side financial PR, stakeholder-facing public relations and in-house corporate communications.</p></div></section>
  <section class="wide-container capability-grid">{groups.map(([en,zh,items],i)=><article class="capability-card"><span class="cap-index">0{i+1}</span><h2 data-en={en} data-zh={zh}>{en}</h2><ul>{items.map(x=><li>{x}</li>)}</ul></article>)}</section>
</BaseLayout>
