---
import BaseLayout from '../../layouts/BaseLayout.astro';
import cases from '../../data/cases.json';
const data = JSON.stringify(cases);
---
<BaseLayout titleZh="案例展示" titleEn="Case Studies">
  <section class="page-hero"><div class="shell"><span class="eyebrow"><span class="zh-only">案例展示</span><span class="en-only">CASE STUDIES</span></span><h1><span class="zh-only">案例展示</span><span class="en-only">Case Studies</span></h1><p><span class="zh-only">以適合公開的活動與項目為主，按媒體活動、企業活動，以及 ESG 及持份者參與分類展示。</span><span class="en-only">Selected public-facing activities and projects, grouped into media events, corporate events, and ESG & stakeholder engagement.</span></p></div></section>
  <section class="section cases-app" data-default={data}>
    <div class="shell"><div class="case-toolbar"><div class="case-filters" id="caseFilters"><button class="filter-button active" data-filter="all"><span class="zh-only">全部</span><span class="en-only">All</span></button><button class="filter-button" data-filter="media"><span class="zh-only">媒體活動</span><span class="en-only">Media Events</span></button><button class="filter-button" data-filter="corporate"><span class="zh-only">企業活動</span><span class="en-only">Corporate Events</span></button><button class="filter-button" data-filter="esg"><span class="zh-only">ESG 及持份者參與</span><span class="en-only">ESG & Stakeholder Engagement</span></button></div></div><div class="case-grid" id="caseGrid"></div><div class="empty-state" id="caseEmpty" hidden><h2><span class="zh-only">內容準備中</span><span class="en-only">Content coming soon</span></h2><p><span class="zh-only">案例會在確認適合公開後逐步加入。</span><span class="en-only">Cases will be added progressively once suitable for public display.</span></p></div></div>
  </section>
<script is:inline>
(() => {
 const app=document.querySelector('.cases-app'); if(!app)return;
 const defaults=JSON.parse(app.dataset.default||'[]'); const grid=document.getElementById('caseGrid'); const empty=document.getElementById('caseEmpty'); let filter='all';
 const esc=(v='')=>String(v).replace(/[&<>'"]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#039;','"':'&quot;'}[ch]));
 const render=()=>{const list=defaults.filter(x=>x.published!==false && (filter==='all'||x.category===filter)); grid.innerHTML=list.map(x=>`<article class="case-card"><div class="case-thumb ${x.image?'':'placeholder'}">${x.image?`<img src="${esc(x.image)}" alt="">`:'<span>SC</span>'}</div><div class="case-body"><div class="case-meta"><span class="case-category"><span class="zh-only">${esc(x.categoryZh)}</span><span class="en-only">${esc(x.categoryEn)}</span></span><span>${esc(x.date||'')}</span></div><h2><span class="zh-only">${esc(x.titleZh)}</span><span class="en-only">${esc(x.titleEn)}</span></h2>${x.company?`<strong>${esc(x.company)}</strong>`:''}<p><span class="zh-only">${esc(x.summaryZh||'')}</span><span class="en-only">${esc(x.summaryEn||'')}</span></p>${x.url?`<a class="text-link" href="${esc(x.url)}" target="_blank" rel="noreferrer"><span class="zh-only">查看公開資料 →</span><span class="en-only">View public source →</span></a>`:''}</div></article>`).join(''); empty.hidden=list.length>0; };
 document.getElementById('caseFilters').addEventListener('click',e=>{const b=e.target.closest('[data-filter]');if(!b)return;filter=b.dataset.filter;document.querySelectorAll('.filter-button').forEach(x=>x.classList.toggle('active',x===b));render();}); render();
})();
</script>
</BaseLayout>
