---
import '../../styles/global.css';
import { defaultContent } from '../../lib/defaultContent';
const fallbackContent = JSON.stringify(defaultContent);
---
<!doctype html>
<html lang="zh-Hant-HK">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <title>Admin | Shirley CHEN</title>
</head>
<body class="admin-body">
  <div class="admin-login" id="loginPanel">
    <div class="admin-login-card"><div class="admin-lock">SC</div><h1>網站管理</h1><p>登入後可直接更新案例、圖片及網站文字，不需要再上傳 GitHub。</p><label>Email<input id="loginEmail" type="email" autocomplete="username" value="Shirley.chensiqi@gmail.com" /></label><label>Password<input id="loginPassword" type="password" autocomplete="current-password" /></label><button class="button primary" id="loginButton">登入</button><p class="admin-error" id="loginError" hidden></p><a href="/">← 返回網站</a></div>
  </div>

  <div class="admin-shell" id="adminApp" hidden data-fallback={fallbackContent}>
    <aside class="admin-sidebar"><a class="admin-brand" href="/">Shirley CHEN</a><strong>網站管理</strong><button class="active" data-panel="cases">案例管理</button><button data-panel="content">網站內容</button><div class="admin-spacer"></div><a href="/cases/" target="_blank">查看案例頁</a><a href="/" target="_blank">查看首頁</a><button id="logout">登出</button></aside>
    <main class="admin-main">
      <section id="casesPanel">
        <div class="admin-top"><div><span>CASE MANAGEMENT</span><h1>案例管理</h1></div><div class="admin-top-actions"><button class="button primary" id="newCase">＋ 新增案例</button></div></div>
        <div class="admin-notice"><strong>V8：</strong>儲存後資料直接寫入 Supabase；圖片直接上傳至 Storage。公開案例會即時出現在網站，不需要 Commit 或重新部署。</div>
        <div class="admin-table" id="adminTable"></div>
      </section>

      <section id="contentPanel" hidden>
        <div class="admin-top"><div><span>SITE CONTENT</span><h1>網站內容</h1></div><div class="admin-top-actions"><button class="button primary" id="saveContent">儲存網站內容</button></div></div>
        <div class="admin-notice">修改後按「儲存網站內容」，首頁、工作經歷及關於我頁面會讀取最新內容。</div>
        <div class="content-editor" id="contentEditor"></div>
      </section>
    </main>
  </div>

  <dialog class="edit-dialog edit-dialog-wide" id="caseDialog">
    <form id="caseForm"><div class="dialog-header"><div><span>CASE EDITOR</span><h2 id="dialogTitle">新增案例</h2></div><button type="button" class="close-dialog" id="closeDialog">×</button></div><input type="hidden" id="caseId" /><div class="editor-scroll">
      <section class="editor-section"><h3>基本資料</h3><div class="form-grid"><label>分類<select id="category"><option value="media">媒體活動 / Media Events</option><option value="corporate">企業活動 / Corporate Events</option><option value="esg">ESG 及持份者參與 / ESG & Stakeholder Engagement</option></select></label><label>日期<input id="dateLabel" placeholder="2026.08" /></label><label class="span-2">中文標題<input id="titleZh" required /></label><label class="span-2">English title<input id="titleEn" required /></label><label class="span-2">公司／機構<input id="company" /></label><label class="span-2">中文簡介<textarea id="summaryZh" rows="4"></textarea></label><label class="span-2">English summary<textarea id="summaryEn" rows="4"></textarea></label><label>排序<input id="sortOrder" type="number" value="0" /></label><label class="toggle-label"><input id="published" type="checkbox" checked /> 公開顯示</label></div></section>
      <section class="editor-section"><div class="editor-section-title"><div><h3>封面圖片</h3><p>JPG / PNG / WebP</p></div><label class="button ghost admin-file-button">選擇封面<input id="coverInput" type="file" accept="image/jpeg,image/png,image/webp" hidden /></label></div><div class="asset-preview-large" id="coverPreview"><span>尚未上傳封面</span></div></section>
      <section class="editor-section"><div class="editor-section-title"><div><h3>活動圖片</h3><p>可一次選取多張。</p></div><label class="button ghost admin-file-button">＋ 加入圖片<input id="galleryInput" type="file" accept="image/jpeg,image/png,image/webp" multiple hidden /></label></div><div class="asset-editor-grid" id="galleryEditor"></div></section>
      <section class="editor-section"><div class="editor-section-title"><div><h3>媒體報導</h3><p>媒體名稱、標題、日期、截圖及原文連結。</p></div><button class="button ghost" id="addCoverage" type="button">＋ 新增媒體報導</button></div><div id="coverageEditor"></div></section>
    </div><div class="dialog-actions"><button class="button ghost" type="button" id="cancelEdit">取消</button><button class="button primary" type="submit">儲存案例</button></div></form>
  </dialog>

<script>
import { supabase, supabaseConfigured } from '../../lib/supabaseClient';
const $=(id:string)=>document.getElementById(id)!; const esc=(v='')=>String(v).replace(/[&<>'"]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#039;','"':'&quot;'}[ch]));
const cat:any={media:['媒體活動','Media Events'],corporate:['企業活動','Corporate Events'],esg:['ESG 及持份者參與','ESG & Stakeholder Engagement']};
let cases:any[]=[]; let editing:any={cover_url:'',gallery:[],coverage:[]}; let siteContent:any=JSON.parse(($('adminApp') as HTMLElement).dataset.fallback||'{}');
const loginPanel=$('loginPanel'), app=$('adminApp');
function msg(text:string){alert(text)}
async function boot(){if(!supabaseConfigured||!supabase){$('loginError').textContent='Supabase 尚未設定。請先完成 SETUP_GUIDE.md 的一次性設定。';$('loginError').hidden=false;return} const {data:{session}}=await supabase.auth.getSession(); if(session) showApp(); else loginPanel.removeAttribute('hidden')}
async function showApp(){loginPanel.setAttribute('hidden','');app.removeAttribute('hidden');await Promise.all([loadCases(),loadContent()]);}
$('loginButton').addEventListener('click',async()=>{if(!supabase)return;const email=(($('loginEmail') as HTMLInputElement).value||'').trim(),password=(($('loginPassword') as HTMLInputElement).value||'');const {error}=await supabase.auth.signInWithPassword({email,password});if(error){$('loginError').textContent=error.message;$('loginError').hidden=false;return}showApp()});
$('logout').addEventListener('click',async()=>{await supabase?.auth.signOut();location.reload()});
document.querySelectorAll('[data-panel]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-panel]').forEach(x=>x.classList.toggle('active',x===b));$('casesPanel').hidden=(b as HTMLElement).dataset.panel!=='cases';$('contentPanel').hidden=(b as HTMLElement).dataset.panel!=='content'}));
async function loadCases(){if(!supabase)return;const {data,error}=await supabase.from('cases').select('*').order('sort_order',{ascending:true}).order('created_at',{ascending:false});if(error){msg(error.message);return}cases=data||[];renderTable()}
function renderTable(){const el=$('adminTable');el.innerHTML=`<div class="admin-row admin-row-head"><span>案例</span><span>分類</span><span>日期</span><span>狀態</span><span>操作</span></div>`+(cases.length?cases.map(x=>`<div class="admin-row" data-id="${x.id}"><span><strong>${esc(x.title_zh)}</strong><small>${esc(x.title_en)}</small></span><span>${esc(x.category_zh)}</span><span>${esc(x.date_label||'—')}</span><span><i class="status ${x.published?'live':''}">${x.published?'已公開':'草稿'}</i></span><span class="row-actions"><button data-action="edit">編輯</button><button data-action="delete">刪除</button></span></div>`).join(''):`<div class="asset-empty">尚未建立案例</div>`)}
const dialog=$('caseDialog') as HTMLDialogElement;
function openCase(x?:any){const v=x?structuredClone(x):{};($('caseId') as HTMLInputElement).value=v.id||'';($('category') as HTMLSelectElement).value=v.category||'media';($('dateLabel') as HTMLInputElement).value=v.date_label||'';($('titleZh') as HTMLInputElement).value=v.title_zh||'';($('titleEn') as HTMLInputElement).value=v.title_en||'';($('company') as HTMLInputElement).value=v.company||'';($('summaryZh') as HTMLTextAreaElement).value=v.summary_zh||'';($('summaryEn') as HTMLTextAreaElement).value=v.summary_en||'';($('sortOrder') as HTMLInputElement).value=String(v.sort_order||0);($('published') as HTMLInputElement).checked=v.published!==false;editing={cover_url:v.cover_url||'',gallery:Array.isArray(v.gallery)?v.gallery:[],coverage:Array.isArray(v.coverage)?v.coverage:[]};$('dialogTitle').textContent=v.id?'修改案例':'新增案例';renderAssets();dialog.showModal()}
$('newCase').addEventListener('click',()=>openCase());$('closeDialog').addEventListener('click',()=>dialog.close());$('cancelEdit').addEventListener('click',()=>dialog.close());
$('adminTable').addEventListener('click',async e=>{const b=(e.target as HTMLElement).closest('[data-action]') as HTMLElement|null;if(!b)return;const id=(b.closest('[data-id]') as HTMLElement).dataset.id;const row=cases.find(x=>x.id===id);if(b.dataset.action==='edit')openCase(row);if(b.dataset.action==='delete'&&confirm('確定刪除此案例？')){const {error}=await supabase!.from('cases').delete().eq('id',id);if(error)msg(error.message);else loadCases()}});
function renderAssets(){$('coverPreview').innerHTML=editing.cover_url?`<img src="${esc(editing.cover_url)}" alt=""><div class="asset-preview-actions"><button type="button" data-remove-cover>移除</button></div>`:'<span>尚未上傳封面</span>';$('galleryEditor').innerHTML=editing.gallery.length?editing.gallery.map((g:any,i:number)=>`<div class="asset-editor-card" data-gallery-index="${i}"><img src="${esc(g.url)}" alt=""><div class="asset-editor-actions"><button type="button" data-move="up" ${i===0?'disabled':''}>↑</button><button type="button" data-move="down" ${i===editing.gallery.length-1?'disabled':''}>↓</button><button type="button" data-remove-gallery>刪除</button></div></div>`).join(''):'<div class="asset-empty">尚未加入活動圖片</div>';$('coverageEditor').innerHTML=editing.coverage.length?editing.coverage.map((c:any,i:number)=>`<article class="coverage-editor-card" data-coverage-index="${i}"><div class="coverage-editor-head"><strong>媒體報導 ${String(i+1).padStart(2,'0')}</strong><button type="button" data-remove-coverage>刪除</button></div><div class="form-grid compact-grid"><label>媒體名稱<input data-c-field="media" value="${esc(c.media||'')}"></label><label>日期<input data-c-field="date" value="${esc(c.date||'')}"></label><label class="span-2">中文報導標題<input data-c-field="title_zh" value="${esc(c.title_zh||'')}"></label><label class="span-2">English headline<input data-c-field="title_en" value="${esc(c.title_en||'')}"></label><label class="span-2">公開原文連結<input type="url" data-c-field="url" value="${esc(c.url||'')}" placeholder="https://..."></label></div><div class="coverage-upload-row"><div class="coverage-admin-shot">${c.screenshot_url?`<img src="${esc(c.screenshot_url)}" alt="">`:'<span>尚未上傳報導截圖</span>'}</div><label class="button ghost admin-file-button">${c.screenshot_url?'更換截圖':'上傳截圖'}<input data-coverage-shot type="file" accept="image/jpeg,image/png,image/webp" hidden></label>${c.screenshot_url?'<button type="button" class="button ghost" data-remove-shot>移除截圖</button>':''}</div></article>`).join(''):'<div class="asset-empty">尚未加入媒體報導</div>'}
async function uploadImage(file:File, folder:string){if(!supabase)throw new Error('Supabase unavailable');const ext=(file.name.split('.').pop()||'jpg').toLowerCase().replace('jpeg','jpg');const name=`${crypto.randomUUID()}.${ext}`;const path=`${folder}/${name}`;const {error}=await supabase.storage.from('portfolio-media').upload(path,file,{cacheControl:'3600',upsert:false});if(error)throw error;return supabase.storage.from('portfolio-media').getPublicUrl(path).data.publicUrl}
$('coverInput').addEventListener('change',async e=>{const f=(e.target as HTMLInputElement).files?.[0];if(!f)return;try{editing.cover_url=await uploadImage(f,'covers');renderAssets()}catch(err:any){msg(err.message)}(e.target as HTMLInputElement).value=''});$('coverPreview').addEventListener('click',e=>{if((e.target as HTMLElement).closest('[data-remove-cover]')){editing.cover_url='';renderAssets()}});
$('galleryInput').addEventListener('change',async e=>{for(const f of Array.from((e.target as HTMLInputElement).files||[])){try{editing.gallery.push({url:await uploadImage(f,'gallery'),caption_zh:'',caption_en:''})}catch(err:any){msg(err.message)}}renderAssets();(e.target as HTMLInputElement).value=''});$('galleryEditor').addEventListener('click',e=>{const card=(e.target as HTMLElement).closest('[data-gallery-index]') as HTMLElement|null;if(!card)return;const i=Number(card.dataset.galleryIndex);if((e.target as HTMLElement).closest('[data-remove-gallery]'))editing.gallery.splice(i,1);const m=((e.target as HTMLElement).closest('[data-move]') as HTMLElement|null)?.dataset.move;if(m==='up'&&i>0)[editing.gallery[i-1],editing.gallery[i]]=[editing.gallery[i],editing.gallery[i-1]];if(m==='down'&&i<editing.gallery.length-1)[editing.gallery[i+1],editing.gallery[i]]=[editing.gallery[i],editing.gallery[i+1]];renderAssets()});
$('addCoverage').addEventListener('click',()=>{editing.coverage.push({media:'',date:'',title_zh:'',title_en:'',url:'',screenshot_url:''});renderAssets()});$('coverageEditor').addEventListener('input',e=>{const card=(e.target as HTMLElement).closest('[data-coverage-index]') as HTMLElement|null;const field=(e.target as HTMLInputElement).dataset.cField;if(card&&field)editing.coverage[Number(card.dataset.coverageIndex)][field]=(e.target as HTMLInputElement).value});$('coverageEditor').addEventListener('change',async e=>{if(!(e.target as HTMLInputElement).matches('[data-coverage-shot]'))return;const card=(e.target as HTMLElement).closest('[data-coverage-index]') as HTMLElement;const f=(e.target as HTMLInputElement).files?.[0];if(!f)return;try{editing.coverage[Number(card.dataset.coverageIndex)].screenshot_url=await uploadImage(f,'coverage');renderAssets()}catch(err:any){msg(err.message)}});$('coverageEditor').addEventListener('click',e=>{const card=(e.target as HTMLElement).closest('[data-coverage-index]') as HTMLElement|null;if(!card)return;const i=Number(card.dataset.coverageIndex);if((e.target as HTMLElement).closest('[data-remove-coverage]')){editing.coverage.splice(i,1);renderAssets()}if((e.target as HTMLElement).closest('[data-remove-shot]')){editing.coverage[i].screenshot_url='';renderAssets()}});
$('caseForm').addEventListener('submit',async e=>{e.preventDefault();const id=(($('caseId') as HTMLInputElement).value||crypto.randomUUID());const category=($('category') as HTMLSelectElement).value;const payload={id,category,category_zh:cat[category][0],category_en:cat[category][1],date_label:($('dateLabel') as HTMLInputElement).value.trim(),title_zh:($('titleZh') as HTMLInputElement).value.trim(),title_en:($('titleEn') as HTMLInputElement).value.trim(),company:($('company') as HTMLInputElement).value.trim(),summary_zh:($('summaryZh') as HTMLTextAreaElement).value.trim(),summary_en:($('summaryEn') as HTMLTextAreaElement).value.trim(),cover_url:editing.cover_url,gallery:editing.gallery,coverage:editing.coverage,published:($('published') as HTMLInputElement).checked,sort_order:Number(($('sortOrder') as HTMLInputElement).value||0),updated_at:new Date().toISOString()};const {error}=await supabase!.from('cases').upsert(payload);if(error){msg(error.message);return}dialog.close();await loadCases();msg('已儲存，公開案例會直接更新到網站。')});
async function loadContent(){if(!supabase)return;const {data}=await supabase.from('site_content').select('payload').eq('key','main').maybeSingle();if(data?.payload)siteContent=data.payload;renderContentEditor()}
function area(label:string,path:string,value:string,rows=3){return `<label class="content-field"><span>${label}</span><textarea rows="${rows}" data-content-path="${path}">${esc(value||'')}</textarea></label>`}
function renderContentEditor(){const s=siteContent.site||{};const caps=siteContent.capabilities||[];const ex=siteContent.experience||[];$('contentEditor').innerHTML=`<section class="editor-section"><h3>首頁 Hero</h3><div class="content-form-grid">${area('繁中定位','site.title.zh',s.title?.zh)}${area('English positioning','site.title.en',s.title?.en)}${area('繁中簡介','site.intro.zh',s.intro?.zh,5)}${area('English introduction','site.intro.en',s.intro?.en,5)}</div></section><section class="editor-section"><h3>我的專業</h3>${caps.map((c:any,i:number)=>`<div class="content-repeat"><strong>0${i+1}</strong><div class="content-form-grid">${area('繁中標題',`capabilities.${i}.title.zh`,c.title?.zh)}${area('English title',`capabilities.${i}.title.en`,c.title?.en)}${area('繁中內容',`capabilities.${i}.text.zh`,c.text?.zh,4)}${area('English text',`capabilities.${i}.text.en`,c.text?.en,4)}</div></div>`).join('')}</section><section class="editor-section"><h3>關於我</h3><div class="content-form-grid">${area('繁中第一段','site.about.zh.0',s.about?.zh?.[0],5)}${area('English paragraph 1','site.about.en.0',s.about?.en?.[0],5)}${area('繁中第二段','site.about.zh.1',s.about?.zh?.[1],5)}${area('English paragraph 2','site.about.en.1',s.about?.en?.[1],5)}</div></section><section class="editor-section"><h3>工作經歷</h3>${ex.map((x:any,i:number)=>`<div class="content-repeat"><strong>${esc(x.company)}</strong><div class="content-form-grid">${area('公司',`experience.${i}.company`,x.company,2)}${area('期間',`experience.${i}.period`,x.period,2)}${area('繁中職位',`experience.${i}.role.zh`,x.role?.zh,2)}${area('English role',`experience.${i}.role.en`,x.role?.en,2)}${area('繁中摘要',`experience.${i}.summary.zh`,x.summary?.zh,4)}${area('English summary',`experience.${i}.summary.en`,x.summary?.en,4)}${area('繁中要點（每行一項）',`experience.${i}.bullets.zh`,(x.bullets?.zh||[]).join('\n'),6)}${area('English bullets (one per line)',`experience.${i}.bullets.en`,(x.bullets?.en||[]).join('\n'),6)}</div></div>`).join('')}</section>`}
function setPath(obj:any,path:string,value:string){const parts=path.split('.');let cur=obj;for(let i=0;i<parts.length-1;i++){const p=parts[i];if(cur[p]==null)cur[p]=/^\d+$/.test(parts[i+1])?[]:{};cur=cur[p]}const last=parts[parts.length-1];if(path.includes('.bullets.'))cur[last]=value.split('\n').map(x=>x.trim()).filter(Boolean);else cur[last]=value}
$('contentEditor').addEventListener('input',e=>{const t=e.target as HTMLTextAreaElement;const path=t.dataset.contentPath;if(path)setPath(siteContent,path,t.value)});$('saveContent').addEventListener('click',async()=>{const {error}=await supabase!.from('site_content').upsert({key:'main',payload:siteContent,updated_at:new Date().toISOString()});if(error)msg(error.message);else msg('網站內容已儲存。')});
boot();
</script>
</body></html>
