---
import '../../styles/global.css';
import cases from '../../data/cases.json';
import { ADMIN_PASSWORD_SHA256 } from '../../data/admin';
const data = JSON.stringify(cases);
---
<!doctype html><html lang="zh-Hant-HK"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Case Admin | Shirley CHEN</title></head><body class="admin-body">
<div class="admin-login" id="loginPanel"><div class="admin-login-card"><div class="admin-lock">SC</div><h1>案例管理</h1><p>此頁不會出現在公開網站導航。</p><label>管理員密碼<input id="adminPassword" type="password" autocomplete="current-password"></label><button class="button primary" id="adminLogin">登入</button><p class="admin-error" id="adminError" hidden>密碼不正確。</p><a href="/cases/">← 返回案例展示</a></div></div>
<div class="admin-shell" id="adminApp" hidden data-default={data} data-hash={ADMIN_PASSWORD_SHA256}>
<aside class="admin-sidebar"><a class="admin-brand" href="/">Shirley CHEN</a><strong>案例管理</strong><button data-admin-filter="all" class="active">全部案例</button><button data-admin-filter="media">媒體活動</button><button data-admin-filter="corporate">企業活動</button><button data-admin-filter="esg">ESG 及持份者參與</button><div class="admin-spacer"></div><a href="/cases/">查看公開頁面</a><button id="logout">登出</button></aside>
<main class="admin-main"><div class="admin-top"><div><span>CASE MANAGEMENT</span><h1>案例管理</h1></div><div><button class="button ghost" id="exportCases">匯出 cases.json</button><button class="button primary" id="newCase">＋ 新增案例</button></div></div><div class="admin-notice">修改會先儲存在這部瀏覽器。確認後按「匯出 cases.json」，再用該檔案替換網站的 <code>src/data/cases.json</code> 即可正式發佈。</div><div class="admin-table" id="adminTable"></div></main>
</div>
<dialog class="edit-dialog" id="caseDialog"><form id="caseForm"><div class="dialog-header"><div><span>CASE EDITOR</span><h2 id="dialogTitle">新增案例</h2></div><button type="button" class="close-dialog" id="closeDialog">×</button></div><input type="hidden" id="caseId"><div class="form-grid"><label>分類<select id="category"><option value="media">媒體活動 / Media Events</option><option value="corporate">企業活動 / Corporate Events</option><option value="esg">ESG 及持份者參與 / ESG & Stakeholder Engagement</option></select></label><label>日期<input id="date" placeholder="2026.08"></label><label class="span-2">中文標題<input id="titleZh" required></label><label class="span-2">English title<input id="titleEn" required></label><label class="span-2">公司／機構<input id="company"></label><label class="span-2">中文簡介<textarea id="summaryZh" rows="4"></textarea></label><label class="span-2">English summary<textarea id="summaryEn" rows="4"></textarea></label><label class="span-2">封面圖片路徑<input id="image" placeholder="/images/cases/example.jpg"></label><label class="span-2">公開連結<input id="url" type="url" placeholder="https://..."></label><label class="check-label"><input id="published" type="checkbox" checked> 對外公開</label></div><div class="dialog-footer"><button type="button" class="button ghost" id="cancelEdit">取消</button><button class="button primary" type="submit">儲存</button></div></form></dialog>
<script is:inline>
(async()=>{
 const hashText=async t=>Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(t)))).map(b=>b.toString(16).padStart(2,'0')).join('');
 const login=document.getElementById('loginPanel'),app=document.getElementById('adminApp'),error=document.getElementById('adminError');
 const unlock=()=>{login.hidden=true;app.hidden=false;sessionStorage.setItem('shirley-admin','1');start();};
 if(sessionStorage.getItem('shirley-admin')==='1') unlock();
 document.getElementById('adminLogin').addEventListener('click',async()=>{const v=document.getElementById('adminPassword').value; if(await hashText(v)===app.dataset.hash)unlock();else error.hidden=false;});
 document.getElementById('adminPassword').addEventListener('keydown',e=>{if(e.key==='Enter')document.getElementById('adminLogin').click();});
 function start(){
   if(app.dataset.started)return;app.dataset.started='1';
   const STORAGE='shirley-cases-v7'; const defaults=JSON.parse(app.dataset.default||'[]'); let items;try{items=JSON.parse(localStorage.getItem(STORAGE))||defaults}catch{items=defaults}; let filter='all';
   const table=document.getElementById('adminTable'),dialog=document.getElementById('caseDialog'),form=document.getElementById('caseForm');
   const cat={media:['媒體活動','Media Events'],corporate:['企業活動','Corporate Events'],esg:['ESG 及持份者參與','ESG & Stakeholder Engagement']};
   const esc=(v='')=>String(v).replace(/[&<>'"]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#039;','"':'&quot;'}[ch]));
   const save=()=>{localStorage.setItem(STORAGE,JSON.stringify(items));render();};
   const render=()=>{const list=items.filter(x=>filter==='all'||x.category===filter); table.innerHTML=`<div class="admin-row admin-head"><span>案例</span><span>分類</span><span>公司</span><span>日期</span><span>狀態</span><span>操作</span></div>`+list.map(x=>`<div class="admin-row" data-id="${esc(x.id)}"><span><strong>${esc(x.titleZh)}</strong><small>${esc(x.titleEn)}</small></span><span>${esc(cat[x.category]?.[0]||'')}</span><span>${esc(x.company||'—')}</span><span>${esc(x.date||'—')}</span><span><i class="status ${x.published!==false?'live':''}">${x.published!==false?'已公開':'草稿'}</i></span><span class="row-actions"><button data-action="edit">編輯</button><button data-action="delete">刪除</button></span></div>`).join('');};
   const open=(x={})=>{document.getElementById('dialogTitle').textContent=x.id?'修改案例':'新增案例';document.getElementById('caseId').value=x.id||'';document.getElementById('category').value=x.category||'media';document.getElementById('date').value=x.date||'';document.getElementById('titleZh').value=x.titleZh||'';document.getElementById('titleEn').value=x.titleEn||'';document.getElementById('company').value=x.company||'';document.getElementById('summaryZh').value=x.summaryZh||'';document.getElementById('summaryEn').value=x.summaryEn||'';document.getElementById('image').value=x.image||'';document.getElementById('url').value=x.url||'';document.getElementById('published').checked=x.published!==false;dialog.showModal();};
   document.querySelectorAll('[data-admin-filter]').forEach(b=>b.addEventListener('click',()=>{filter=b.dataset.adminFilter;document.querySelectorAll('[data-admin-filter]').forEach(x=>x.classList.toggle('active',x===b));render();}));
   document.getElementById('newCase').addEventListener('click',()=>open()); document.getElementById('closeDialog').onclick=()=>dialog.close();document.getElementById('cancelEdit').onclick=()=>dialog.close();
   table.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(!b)return;const id=b.closest('[data-id]').dataset.id;const idx=items.findIndex(x=>x.id===id);if(b.dataset.action==='edit')open(items[idx]);if(b.dataset.action==='delete'&&confirm('確定刪除此案例？')){items.splice(idx,1);save();}});
   form.addEventListener('submit',e=>{e.preventDefault();const id=document.getElementById('caseId').value||('case-'+Date.now());const category=document.getElementById('category').value;const entry={id,category,categoryZh:cat[category][0],categoryEn:cat[category][1],date:document.getElementById('date').value.trim(),titleZh:document.getElementById('titleZh').value.trim(),titleEn:document.getElementById('titleEn').value.trim(),company:document.getElementById('company').value.trim(),summaryZh:document.getElementById('summaryZh').value.trim(),summaryEn:document.getElementById('summaryEn').value.trim(),image:document.getElementById('image').value.trim(),url:document.getElementById('url').value.trim(),published:document.getElementById('published').checked};const i=items.findIndex(x=>x.id===id);if(i>=0)items[i]=entry;else items.unshift(entry);save();dialog.close();});
   document.getElementById('exportCases').addEventListener('click',()=>{const blob=new Blob([JSON.stringify(items,null,2)],{type:'application/json'});const u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download='cases.json';a.click();URL.revokeObjectURL(u);});
   document.getElementById('logout').addEventListener('click',()=>{sessionStorage.removeItem('shirley-admin');location.reload();}); render();
 }
})();
</script></body></html>
