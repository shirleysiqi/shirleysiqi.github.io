---
import BaseLayout from '../layouts/BaseLayout.astro';
const projects=[
['Compliance Control Framework Enhancement','Fragmented controls and unclear ownership','Led a cross-functional review and redesign of the compliance control framework.','Mapped key risks, clarified ownership, rationalised controls and strengthened management reporting.','Improved transparency, reduced duplication and strengthened oversight.'],
['Regulatory Change Programme','New regulatory expectations required coordinated implementation across multiple functions.','Coordinated interpretation and implementation across business and control stakeholders.','Converted regulatory requirements into actionable tasks, ownership and governance milestones.','Improved implementation discipline and senior management visibility.'],
['Compliance Process Transformation','Manual processes created inefficiency and limited management information.','Drove redesign toward a more structured and data-driven workflow.','Standardised inputs, introduced workflow discipline and improved reporting logic.','Enhanced consistency, traceability and decision support.']
];
---
<BaseLayout title="Selected Impact | Shirley Siqi"><section class="page-hero"><div class="container"><div class="eyebrow">Selected Impact</div><h1>Representative Work</h1><p>Public-safe examples structured around challenge, role, approach and outcome.</p></div></section><section class="section"><div class="container">{projects.map((p,i)=><article class="card" style="margin-bottom:24px"><div class="number">0{i+1}</div><h2 style="font-size:30px">{p[0]}</h2><div class="grid-4"><div><div class="kicker">Challenge</div><p>{p[1]}</p></div><div><div class="kicker">My Role</div><p>{p[2]}</p></div><div><div class="kicker">Approach</div><p>{p[3]}</p></div><div><div class="kicker">Outcome</div><p>{p[4]}</p></div></div></article>)}</div></section><section class="section alt"><div class="container"><div class="notice"><strong>Confidentiality note:</strong> Keep all examples anonymised and do not publish client names, internal documents, regulatory correspondence, non-public metrics or screenshots.</div></div></section></BaseLayout>
