---
import BaseLayout from '../layouts/BaseLayout.astro';
import { education, languages, site, capabilities, experience } from '../data/site';
const fallback = JSON.stringify({site, capabilities, experience, education, languages});
---
<BaseLayout titleZh="關於我" titleEn="About Me">
  <section class="page-hero"><div class="shell"><span class="eyebrow"><span class="zh-only">關於我</span><span class="en-only">ABOUT ME</span></span><h1><span class="zh-only">關於 Shirley</span><span class="en-only">About Shirley</span></h1></div></section>
  <div id="aboutApp" data-fallback={fallback}>
  <section class="section"><div class="shell about-grid"><div class="about-photo"><img src="/images/shirley-chen-profile.jpg" alt="Shirley CHEN" /></div><div class="about-copy"><h2>Shirley CHEN <span class="zh-only">陳思琦</span></h2><div class="zh-only" id="aboutZh">{site.about.zh.map(p=><p>{p}</p>)}</div><div class="en-only" id="aboutEn">{site.about.en.map(p=><p>{p}</p>)}</div></div></div></section>
  <section class="section soft-section"><div class="shell about-details"><div><h3><span class="zh-only">教育背景</span><span class="en-only">Education</span></h3><div id="educationList">{education.map(e=><article class="detail-row"><strong>{e.school}</strong><span>{e.degree}</span><small>{e.period}</small><small><span class="zh-only">{e.note.zh}</span><span class="en-only">{e.note.en}</span></small></article>)}</div></div><div><h3><span class="zh-only">語言能力</span><span class="en-only">Languages</span></h3><ul class="simple-list zh-only" id="languagesZh">{languages.zh.map(l=><li>{l}</li>)}</ul><ul class="simple-list en-only" id="languagesEn">{languages.en.map(l=><li>{l}</li>)}</ul></div><div><h3><span class="zh-only">聯絡方式</span><span class="en-only">Contact</span></h3><a id="contactEmail" href={`mailto:${site.email}`}>{site.email}</a><a id="contactLinkedin" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a></div></div></section>
  </div>
<script>
import { loadSiteContent } from '../scripts/publicContent';
const esc=(v='')=>String(v).replace(/[&<>'"]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#039;','"':'&quot;'}[ch]));
const app=document.getElementById('aboutApp'); const fallback=JSON.parse(app?.dataset.fallback||'{}');
loadSiteContent(fallback).then((c:any)=>{const az=document.getElementById('aboutZh'),ae=document.getElementById('aboutEn');if(az)az.innerHTML=(c.site?.about?.zh||[]).map((p:string)=>`<p>${esc(p)}</p>`).join('');if(ae)ae.innerHTML=(c.site?.about?.en||[]).map((p:string)=>`<p>${esc(p)}</p>`).join('');const ed=document.getElementById('educationList');if(ed&&Array.isArray(c.education))ed.innerHTML=c.education.map((e:any)=>`<article class="detail-row"><strong>${esc(e.school)}</strong><span>${esc(e.degree)}</span><small>${esc(e.period)}</small><small><span class="zh-only">${esc(e.note?.zh)}</span><span class="en-only">${esc(e.note?.en)}</span></small></article>`).join('');const lz=document.getElementById('languagesZh'),le=document.getElementById('languagesEn');if(lz)lz.innerHTML=(c.languages?.zh||[]).map((x:string)=>`<li>${esc(x)}</li>`).join('');if(le)le.innerHTML=(c.languages?.en||[]).map((x:string)=>`<li>${esc(x)}</li>`).join('');const em=document.getElementById('contactEmail') as HTMLAnchorElement|null;if(em&&c.site?.email){em.textContent=c.site.email;em.href=`mailto:${c.site.email}`};const li=document.getElementById('contactLinkedin') as HTMLAnchorElement|null;if(li&&c.site?.linkedin)li.href=c.site.linkedin;});
</script>
</BaseLayout>
