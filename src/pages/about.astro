---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, education, languages } from '../data/site';
---
<BaseLayout title="關於我">
  <section class="page-hero shell">
    <span class="eyebrow dark-text">ABOUT</span>
    <h1>關於我</h1>
    <p>企業傳訊、媒體關係與財經公關背景，立足香港的專業傳訊經驗。</p>
  </section>
  <section class="section shell about-grid">
    <div class="about-photo"><img src="/images/shirley-chen-profile.jpg" alt="Shirley CHEN 陳思琦" /></div>
    <div class="about-copy">
      <span class="eyebrow dark-text">PROFESSIONAL PROFILE</span>
      <h2>Shirley CHEN 陳思琦</h2>
      {site.about.map((p) => <p>{p}</p>)}
      <div class="about-contact-row">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn →</a>
      </div>
    </div>
  </section>
  <section class="section soft-section">
    <div class="shell two-column-info">
      <div>
        <div class="section-heading"><span>EDUCATION</span><h2>教育背景</h2></div>
        <div class="info-stack">
          {education.map((item) => (
            <article><h3>{item.school}</h3><p>{item.degree}</p><span>{item.period}</span>{item.note && <small>{item.note}</small>}</article>
          ))}
        </div>
      </div>
      <div>
        <div class="section-heading"><span>LANGUAGES</span><h2>語言能力</h2></div>
        <div class="language-grid">{languages.map((lang) => <span>{lang}</span>)}</div>
      </div>
    </div>
  </section>
</BaseLayout>
