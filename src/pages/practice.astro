---
import BaseLayout from '../layouts/BaseLayout.astro';
import defaultPractice from '../data/practice.json';
---
<BaseLayout title="專業實踐">
  <section class="page-hero shell practice-hero">
    <span class="eyebrow dark-text">PROFESSIONAL HIGHLIGHTS</span>
    <h1>專業實踐</h1>
    <p>整理媒體活動、企業活動，以及 ESG 與持份者參與相關經驗。內容以公開及適合展示的資料為主。</p>
    <div class="editor-note" id="editorNote" hidden>你正在使用前台編輯模式。修改會先儲存在這部裝置的瀏覽器。</div>
  </section>
  <section class="section shell practice-app" data-default={JSON.stringify(defaultPractice)}>
    <div class="practice-toolbar">
      <div class="filter-row" id="filters">
        <button class="filter-button active" data-filter="全部">全部</button>
        <button class="filter-button" data-filter="媒體活動">媒體活動</button>
        <button class="filter-button" data-filter="企業活動">企業活動</button>
        <button class="filter-button" data-filter="ESG 及持份者參與">ESG 及持份者參與</button>
      </div>
      <div class="edit-actions" id="editActions" hidden>
        <button class="button primary small" id="addItem">＋ 新增項目</button>
        <button class="button secondary dark small" id="exportData">匯出更新檔</button>
        <button class="button ghost small" id="resetData">還原已發佈內容</button>
      </div>
    </div>
    <div class="practice-grid" id="practiceGrid"></div>
    <div class="empty-state" id="emptyState" hidden>
      <h2>尚未加入公開項目</h2>
      <p>你可以逐步加入適合公開展示的媒體活動、企業活動或 ESG／持份者參與經驗。</p>
      <p class="edit-only" hidden>目前是編輯模式，按「新增項目」即可直接在此頁建立第一個內容。</p>
    </div>
  </section>

  <dialog class="edit-dialog" id="editDialog">
    <form method="dialog" id="editForm">
      <div class="dialog-header"><div><span>前台內容編輯</span><h2 id="dialogTitle">新增專業實踐</h2></div><button class="close-dialog" value="cancel" aria-label="關閉">×</button></div>
      <input type="hidden" id="itemId" />
      <div class="form-grid">
        <label>分類<select id="category" required><option>媒體活動</option><option>企業活動</option><option>ESG 及持份者參與</option></select></label>
        <label>日期<input id="date" placeholder="例如：2026.08" /></label>
        <label class="span-2">項目名稱<input id="title" required placeholder="輸入項目或活動名稱" /></label>
        <label class="span-2">公司／機構<input id="company" placeholder="公司或機構名稱" /></label>
        <label class="span-2">簡介<textarea id="summary" rows="4" placeholder="用 2–4 句說明活動或項目內容"></textarea></label>
        <label class="span-2">媒體／合作單位<input id="media" placeholder="例如：Bloomberg、Reuters、TVB；以逗號分隔" /></label>
        <label class="span-2">公開連結<input id="url" type="url" placeholder="https://..." /></label>
        <label class="span-2">封面圖片網址<input id="image" placeholder="/images/xxx.jpg 或 https://..." /></label>
        <label class="span-2 upload-label">或直接選擇圖片<input id="imageFile" type="file" accept="image/*" /><small>圖片會壓縮後儲存在此瀏覽器，適合少量圖片預覽與編輯。</small></label>
      </div>
      <div class="dialog-footer"><button class="button ghost" value="cancel">取消</button><button class="button primary" id="saveItem" value="default">儲存</button></div>
    </form>
  </dialog>

  <script is:inline>
    (() => {
      const app = document.querySelector('.practice-app');
      if (!app) return;
      const STORAGE_KEY = 'shirley-practice-v6';
      const defaults = JSON.parse(app.dataset.default || '[]');
      const params = new URLSearchParams(location.search);
      const editMode = params.get('edit') === '1';
      const grid = document.getElementById('practiceGrid');
      const emptyState = document.getElementById('emptyState');
      const editActions = document.getElementById('editActions');
      const editorNote = document.getElementById('editorNote');
      const dialog = document.getElementById('editDialog');
      const form = document.getElementById('editForm');
      let currentFilter = '全部';
      let items = defaults;
      try { const saved = localStorage.getItem(STORAGE_KEY); if (saved) items = JSON.parse(saved); } catch(e) {}

      if (editMode) {
        editActions.hidden = false;
        editorNote.hidden = false;
        document.querySelectorAll('.edit-only').forEach(el => el.hidden = false);
      }

      const esc = (value='') => String(value).replace(/[&<>'"]/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#039;','"':'&quot;'}[ch]));
      const visibleItems = () => currentFilter === '全部' ? items : items.filter(i => i.category === currentFilter);

      function render() {
        const list = visibleItems();
        grid.innerHTML = list.map((item) => `
          <article class="practice-card" data-id="${esc(item.id)}">
            <div class="practice-image ${item.image ? '' : 'placeholder'}">
              ${item.image ? `<img src="${esc(item.image)}" alt="">` : `<div class="placeholder-mark">${esc(item.category || '專業實踐')}</div>`}
              ${editMode ? `<div class="card-edit-controls"><button data-action="up" title="上移">↑</button><button data-action="down" title="下移">↓</button><button data-action="edit">編輯</button><button data-action="delete" class="danger">刪除</button></div>` : ''}
            </div>
            <div class="practice-body">
              <div class="practice-meta"><span class="category-pill">${esc(item.category)}</span><span>${esc(item.date)}</span></div>
              <h2>${esc(item.title)}</h2>
              ${item.company ? `<strong>${esc(item.company)}</strong>` : ''}
              ${item.summary ? `<p>${esc(item.summary)}</p>` : ''}
              ${item.media?.length ? `<div class="media-tags">${item.media.map(m => `<span>${esc(m)}</span>`).join('')}</div>` : ''}
              ${item.url ? `<a class="text-link" href="${esc(item.url)}" target="_blank" rel="noreferrer">查看公開資料 →</a>` : ''}
            </div>
          </article>`).join('');
        emptyState.hidden = list.length !== 0;
      }

      function persist() { localStorage.setItem(STORAGE_KEY, JSON.stringify(items)); render(); }
      function uid() { return 'p-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2,7); }
      function openEditor(item = null) {
        document.getElementById('dialogTitle').textContent = item ? '修改專業實踐' : '新增專業實踐';
        document.getElementById('itemId').value = item?.id || '';
        document.getElementById('category').value = item?.category || '媒體活動';
        document.getElementById('date').value = item?.date || '';
        document.getElementById('title').value = item?.title || '';
        document.getElementById('company').value = item?.company || '';
        document.getElementById('summary').value = item?.summary || '';
        document.getElementById('media').value = item?.media?.join(', ') || '';
        document.getElementById('url').value = item?.url || '';
        document.getElementById('image').value = item?.image || '';
        document.getElementById('imageFile').value = '';
        dialog.showModal();
      }
      async function fileToCompressedDataURL(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader(); reader.onerror = reject;
          reader.onload = () => {
            const img = new Image(); img.onerror = reject;
            img.onload = () => {
              const max = 1200; const scale = Math.min(1, max / Math.max(img.width, img.height));
              const canvas = document.createElement('canvas'); canvas.width = Math.round(img.width * scale); canvas.height = Math.round(img.height * scale);
              canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
              resolve(canvas.toDataURL('image/jpeg', .82));
            }; img.src = reader.result;
          }; reader.readAsDataURL(file);
        });
      }

      document.getElementById('filters').addEventListener('click', (e) => {
        const btn = e.target.closest('[data-filter]'); if (!btn) return;
        currentFilter = btn.dataset.filter;
        document.querySelectorAll('.filter-button').forEach(b => b.classList.toggle('active', b === btn)); render();
      });
      if (editMode) {
        document.getElementById('addItem').addEventListener('click', () => openEditor());
        grid.addEventListener('click', (e) => {
          const btn = e.target.closest('[data-action]'); if (!btn) return;
          const card = btn.closest('[data-id]'); const id = card.dataset.id; const index = items.findIndex(i => i.id === id); if (index < 0) return;
          const action = btn.dataset.action;
          if (action === 'edit') openEditor(items[index]);
          if (action === 'delete' && confirm('確定刪除這個項目？')) { items.splice(index, 1); persist(); }
          if (action === 'up' && index > 0) { [items[index-1], items[index]] = [items[index], items[index-1]]; persist(); }
          if (action === 'down' && index < items.length-1) { [items[index+1], items[index]] = [items[index], items[index+1]]; persist(); }
        });
        document.getElementById('saveItem').addEventListener('click', async (e) => {
          e.preventDefault();
          const title = document.getElementById('title').value.trim(); if (!title) { alert('請輸入項目名稱。'); return; }
          const id = document.getElementById('itemId').value || uid();
          const old = items.find(i => i.id === id);
          let image = document.getElementById('image').value.trim() || old?.image || '';
          const file = document.getElementById('imageFile').files[0];
          if (file) { try { image = await fileToCompressedDataURL(file); } catch(err) { alert('圖片處理失敗，請改用圖片網址。'); } }
          const item = {
            id,
            category: document.getElementById('category').value,
            date: document.getElementById('date').value.trim(),
            title,
            company: document.getElementById('company').value.trim(),
            summary: document.getElementById('summary').value.trim(),
            media: document.getElementById('media').value.split(/[,，]/).map(s => s.trim()).filter(Boolean),
            url: document.getElementById('url').value.trim(),
            image
          };
          const index = items.findIndex(i => i.id === id); if (index >= 0) items[index] = item; else items.unshift(item);
          persist(); dialog.close();
        });
        document.getElementById('exportData').addEventListener('click', () => {
          const blob = new Blob([JSON.stringify(items, null, 2)], {type:'application/json'});
          const url = URL.createObjectURL(blob); const a = document.createElement('a'); a.href = url; a.download = 'practice.json'; a.click(); URL.revokeObjectURL(url);
        });
        document.getElementById('resetData').addEventListener('click', () => {
          if (!confirm('要清除這部裝置的編輯內容，還原網站目前已發佈的資料嗎？')) return;
          localStorage.removeItem(STORAGE_KEY); items = defaults; render();
        });
      }
      render();
    })();
  </script>
</BaseLayout>
