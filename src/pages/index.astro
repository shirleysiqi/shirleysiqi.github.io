---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Shirley Siqi | Compliance & Controls Executive Portfolio">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">Investment Banking · Hong Kong</div>
        <h1>Shirley Siqi</h1>
        <h2>Compliance · Controls · Governance</h2>
        <p>Building scalable compliance and control frameworks for complex financial businesses, with a focus on governance, business advisory and transformation.</p>
        <div style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap">
          <a class="btn btn-primary" href="/impact">View Selected Impact</a>
          <a class="btn btn-outline" href="/contact">Contact Me</a>
        </div>
        <div class="metric-grid">
          <div class="metric"><strong>10+</strong><span>Years in Financial Services</span></div>
          <div class="metric"><strong>APAC</strong><span>Market Coverage</span></div>
          <div class="metric"><strong>15+</strong><span>Major Initiatives</span></div>
          <div class="metric"><strong>4</strong><span>Core Capability Areas</span></div>
        </div>
      </div>
      <div class="hero-panel">
        <div class="kicker">Professional Focus</div>
        <p class="quote">Translating regulatory expectations into practical governance, controls and sustainable business processes.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><div class="kicker">Capabilities</div><h2>What I Do</h2></div><p class="section-lead">A concise view of the professional areas I want external stakeholders to associate with my profile.</p></div>
      <div class="grid-4">
        <div class="card"><h3>Regulatory Compliance</h3><p>Regulatory advisory, policy interpretation, licensing, regulatory change and stakeholder engagement.</p><span class="tag">SFC</span><span class="tag">HKMA</span><span class="tag">HKEX</span></div>
        <div class="card"><h3>Controls & Governance</h3><p>Control frameworks, risk assessments, control testing, issue management and governance reporting.</p><span class="tag">RCSA</span><span class="tag">Testing</span><span class="tag">Governance</span></div>
        <div class="card"><h3>Business Advisory</h3><p>Partnering with front-office and business teams to manage conduct and regulatory risks pragmatically.</p><span class="tag">IBD</span><span class="tag">Capital Markets</span></div>
        <div class="card"><h3>Transformation</h3><p>Workflow redesign, data analytics, automation, management information and emerging RegTech / AI use cases.</p><span class="tag">RegTech</span><span class="tag">Data</span><span class="tag">AI</span></div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head"><div><div class="kicker">Portfolio</div><h2>Selected Impact</h2></div><a class="btn btn-outline" href="/impact">View All</a></div>
      <div class="grid-3">
        <article class="card impact-card"><div class="impact-art"></div><div class="impact-body"><div class="number">01</div><h3>Compliance Control Framework Enhancement</h3><p>Redesigned control ownership and governance to improve transparency and oversight.</p></div></article>
        <article class="card impact-card"><div class="impact-art"></div><div class="impact-body"><div class="number">02</div><h3>Regulatory Change Programme</h3><p>Translated new regulatory expectations into actionable business and control requirements.</p></div></article>
        <article class="card impact-card"><div class="impact-art"></div><div class="impact-body"><div class="number">03</div><h3>Compliance Process Transformation</h3><p>Moved a manual process toward a more structured and data-driven operating model.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div><div class="kicker">Career</div><h2>Career Journey</h2><p class="section-lead">A progression from hands-on compliance execution toward broader governance, stakeholder leadership and transformation.</p><a class="btn btn-outline" href="/career">View Career Timeline</a></div>
      <div class="timeline">
        <div class="timeline-item"><h3>Compliance / CC Manager</h3><div class="timeline-meta">Global Investment Bank · Hong Kong · 2024–Present</div></div>
        <div class="timeline-item"><h3>Senior Compliance / Controls Role</h3><div class="timeline-meta">Financial Institution · 2020–2024</div></div>
        <div class="timeline-item"><h3>Compliance / Risk</h3><div class="timeline-meta">Financial Services Firm · 2016–2020</div></div>
      </div>
    </div>
  </section>

  <section class="cta"><div class="container"><div><div class="kicker">Connect</div><h2 style="margin:6px 0 0">Let’s exchange perspectives on compliance, governance and the future of financial services.</h2></div><a class="btn btn-primary" href="/contact">Contact Me</a></div></section>
</BaseLayout>
