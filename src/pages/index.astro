---
import BaseLayout from '../layouts/BaseLayout.astro';
import { capabilities, experience, site } from '../data/site';
import cases from '../data/cases.json';
const featured = (cases as any[]).filter(c => c.published !== false).slice(0,3);
---
<BaseLayout titleZh="首頁" titleEn="Home">
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="hero-kicker"><span class="zh-only">{site.heroKicker.zh}</span><span class="en-only">{site.heroKicker.en}</span></div>
        <h1><span>Shirley CHEN</span><em class="zh-only">陳思琦</em></h1>
        <h2><span class="zh-only">{site.title.zh}</span><span class="en-only">{site.title.en}</span></h2>
        <p><span class="zh-only">{site.intro.zh}</span><span class="en-only">{site.intro.en}</span></p>
        <div class="hero-tags">
          {capabilities.map(c => <a href="#expertise"><span class="zh-only">{c.title.zh}</span><span class="en-only">{c.title.en}</span></a>)}
        </div>
        <div class="hero-actions">
          <a class="button primary" href="/experience/"><span class="zh-only">了解我的經歷</span><span class="en-only">View Experience</span></a>
          <a class="button secondary" href="/cases/"><span class="zh-only">查看案例展示</span><span class="en-only">View Case Studies</span></a>
        </div>
      </div>
      <div class="portrait-wrap">
        <div class="portrait-halo"></div>
        <img src="/images/shirley-chen-profile.jpg" alt="Shirley CHEN" />
      </div>
    </div>
  </section>

  <section class="section" id="expertise">
    <div class="shell">
      <div class="section-heading centered"><span><span class="zh-only">專業領域</span><span class="en-only">WHAT I DO</span></span><h2><span class="zh-only">我的專業</span><span class="en-only">Core Expertise</span></h2></div>
      <div class="capability-grid">
        {capabilities.map((c, i) => <article class="capability-card"><div class="capability-number">0{i+1}</div><h3><span class="zh-only">{c.title.zh}</span><span class="en-only">{c.title.en}</span></h3><p><span class="zh-only">{c.text.zh}</span><span class="en-only">{c.text.en}</span></p></article>)}
      </div>
    </div>
  </section>

  <section class="section soft-section">
    <div class="shell">
      <div class="section-heading split-heading"><div><span><span class="zh-only">工作經歷</span><span class="en-only">EXPERIENCE</span></span><h2><span class="zh-only">職業概覽</span><span class="en-only">Career Snapshot</span></h2></div><a class="text-link" href="/experience/"><span class="zh-only">查看完整經歷 →</span><span class="en-only">Full experience →</span></a></div>
      <div class="timeline-snapshot">{experience.map(item => <article><div class="period">{item.period}</div><h3>{item.company}</h3><strong><span class="zh-only">{item.role.zh}</span><span class="en-only">{item.role.en}</span></strong><p><span class="zh-only">{item.summary.zh}</span><span class="en-only">{item.summary.en}</span></p></article>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading split-heading"><div><span><span class="zh-only">案例展示</span><span class="en-only">CASE STUDIES</span></span><h2><span class="zh-only">專業案例</span><span class="en-only">Selected Cases</span></h2></div><a class="text-link" href="/cases/"><span class="zh-only">查看全部 →</span><span class="en-only">View all →</span></a></div>
      {featured.length ? <div class="case-grid">{featured.map((item:any) => <article class="case-card"><div class="case-thumb">{item.image && <img src={item.image} alt="" />}</div><div class="case-body"><span class="case-category"><span class="zh-only">{item.categoryZh}</span><span class="en-only">{item.categoryEn}</span></span><h3><span class="zh-only">{item.titleZh}</span><span class="en-only">{item.titleEn}</span></h3></div></article>)}</div> : <div class="empty-feature"><div><strong><span class="zh-only">案例內容將逐步更新</span><span class="en-only">Case studies will be added progressively</span></strong><p><span class="zh-only">只展示適合公開的媒體活動、企業活動，以及 ESG 與持份者參與案例。</span><span class="en-only">Only suitable public-facing media events, corporate events, and ESG & stakeholder engagement cases will be shown.</span></p></div><a class="button ghost" href="/cases/"><span class="zh-only">進入案例展示</span><span class="en-only">Case Studies</span></a></div>}
    </div>
  </section>
</BaseLayout>
