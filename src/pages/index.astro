---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Siqi Chen | Corporate Communications & Financial PR">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">Hong Kong · Financial Services</div>
        <h1>Siqi Chen 陳思琦</h1>
        <h2>Corporate Communications · Financial PR · Investor Relations</h2>
        <p>Building trusted corporate narratives and stakeholder relationships across financial markets, listed companies and public-facing organisations.</p>
        <div style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap">
          <a class="btn btn-primary" href="/impact">View Selected Work</a>
          <a class="btn btn-outline" href="/contact">Contact Me</a>
        </div>
        <div class="metric-grid">
          <div class="metric"><strong>15+</strong><span>Listed-company clients supported</span></div>
          <div class="metric"><strong>3</strong><span>Professional environments</span></div>
          <div class="metric"><strong>360°</strong><span>Communications exposure</span></div>
          <div class="metric"><strong>HK</strong><span>Financial-market focus</span></div>
        </div>
      </div>
      <div class="hero-panel">
        <div class="kicker">Professional Focus</div>
        <p class="quote">Connecting corporate strategy with clear messaging, media engagement, stakeholder communications and reputation management.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><div class="kicker">Capabilities</div><h2>What I Do</h2></div><p class="section-lead">A cross-section of in-house, agency-side and stakeholder-facing communications experience.</p></div>
      <div class="grid-4">
        <div class="card"><h3>Corporate Communications</h3><p>Bilingual press releases, corporate messaging, website content, newsletters and external information updates.</p><span class="tag">Messaging</span><span class="tag">Press Releases</span><span class="tag">Publications</span></div>
        <div class="card"><h3>Media Relations</h3><p>Media pitching, interview coordination, media-list management, monitoring and public-opinion tracking.</p><span class="tag">Media Pitch</span><span class="tag">Interviews</span><span class="tag">Monitoring</span></div>
        <div class="card"><h3>Financial PR & IR</h3><p>Listed-company communications, investor-facing events, stakeholder engagement and market messaging support.</p><span class="tag">Listed Companies</span><span class="tag">IR</span><span class="tag">Events</span></div>
        <div class="card"><h3>Brand, ESG & Engagement</h3><p>Brand management, social media, ESG activities, corporate events and stakeholder-facing communications.</p><span class="tag">Branding</span><span class="tag">ESG</span><span class="tag">Digital</span></div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="section-head"><div><div class="kicker">Portfolio</div><h2>Selected Work</h2></div><a class="btn btn-outline" href="/impact">View All</a></div>
      <div class="grid-3">
        <article class="card impact-card"><div class="impact-art"></div><div class="impact-body"><div class="number">01</div><h3>Corporate Communications & Media Relations</h3><p>Managing bilingual content, media engagement, digital channels and corporate information for a financial institution.</p></div></article>
        <article class="card impact-card"><div class="impact-art"></div><div class="impact-body"><div class="number">02</div><h3>Listed-company Financial PR & IR</h3><p>Supporting approximately 15 listed-company clients across messaging, investor communications, media relations and events.</p></div></article>
        <article class="card impact-card"><div class="impact-art"></div><div class="impact-body"><div class="number">03</div><h3>ESG & Stakeholder Engagement</h3><p>Planning ESG activities and stakeholder-facing communications across corporate and project environments.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div><div class="kicker">Career</div><h2>Career Journey</h2><p class="section-lead">A progression from financial PR agency work to public stakeholder relations and in-house corporate communications within financial services.</p><a class="btn btn-outline" href="/career">View Career Timeline</a></div>
      <div class="timeline">
        <div class="timeline-item"><h3>Corporate Communication — Assistant Manager</h3><div class="timeline-meta">Haitong International Securities Group Limited · 2024–Present</div></div>
        <div class="timeline-item"><h3>Assistant Public Relation Officer</h3><div class="timeline-meta">Chun Wo Development Holding Limited · 2023–2024</div></div>
        <div class="timeline-item"><h3>Senior PR Associate</h3><div class="timeline-meta">Wonderful Sky Financial Group Limited · 2021–2022</div></div>
      </div>
    </div>
  </section>

  <section class="cta"><div class="container"><div><div class="kicker">Connect</div><h2 style="margin:6px 0 0">Let’s exchange perspectives on corporate communications, financial PR and stakeholder engagement.</h2></div><a class="btn btn-primary" href="/contact">Contact Me</a></div></section>
</BaseLayout>
