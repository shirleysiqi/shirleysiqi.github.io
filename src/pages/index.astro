---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, capabilities, experience } from '../data/site';
import practice from '../data/practice.json';
const featured = practice.slice(0, 3);
---
<BaseLayout>
  <section class="hero">
    <div class="hero-lines" aria-hidden="true"></div>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">HONG KONG · CORPORATE COMMUNICATIONS</div>
        <h1><span>Shirley CHEN</span><em>陳思琦</em></h1>
        <h2>{site.role}</h2>
        <div class="role-en">{site.roleEn}</div>
        <p>{site.intro}</p>
        <div class="hero-actions">
          <a class="button primary" href="/experience/">了解我的經歷</a>
          <a class="button secondary" href="/practice/">查看專業實踐</a>
        </div>
      </div>
      <div class="portrait-wrap">
        <div class="portrait-halo"></div>
        <img src="/images/shirley-chen-profile.jpg" alt="Shirley CHEN 陳思琦" />
        <div class="portrait-caption"><span>企業傳訊</span><span>媒體關係</span><span>財經公關</span></div>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading centered">
      <span>WHAT I DO</span><h2>我的專業</h2>
    </div>
    <div class="capability-grid">
      {capabilities.map((item, i) => (
        <article class="capability-card">
          <div class="capability-number">0{i + 1}</div>
          <h3>{item.title}</h3>
          <div class="small-en">{item.en}</div>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section soft-section">
    <div class="shell">
      <div class="section-heading split-heading">
        <div><span>EXPERIENCE</span><h2>工作經歷</h2></div>
        <a class="text-link" href="/experience/">查看完整經歷 →</a>
      </div>
      <div class="timeline-snapshot">
        {experience.map((job) => (
          <article>
            <div class="period">{job.period}</div>
            <h3>{job.company}</h3>
            <strong>{job.role}</strong>
            <p>{job.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading split-heading">
      <div><span>PROFESSIONAL HIGHLIGHTS</span><h2>專業實踐</h2></div>
      <a class="text-link" href="/practice/">查看全部 →</a>
    </div>
    {featured.length > 0 ? (
      <div class="practice-grid compact">
        {featured.map((item) => (
          <article class="practice-card">
            {item.image && <img src={item.image} alt="" />}
            <div class="practice-body">
              <span class="category-pill">{item.category}</span>
              <h3>{item.title}</h3><p>{item.summary}</p>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-feature">
        <div>
          <strong>專業實踐內容可按需要逐步加入。</strong>
          <p>此區域將整理媒體活動、企業活動，以及 ESG 與持份者參與相關經驗。</p>
        </div>
        <a class="button secondary dark" href="/practice/">進入專業實踐</a>
      </div>
    )}
  </section>

  <section class="contact-strip">
    <div class="shell contact-strip-inner">
      <div><span>LET’S CONNECT</span><h2>保持聯繫</h2></div>
      <p>歡迎就企業傳訊、媒體合作及專業交流與我聯絡。</p>
      <div class="contact-actions">
        <a class="button primary" href={`mailto:${site.email}`}>Email</a>
        <a class="button secondary" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </div>
  </section>
</BaseLayout>
