---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.intro } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | 企業傳訊 · 媒體關係 · 財經公關`;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '首頁' },
  { href: '/experience/', label: '工作經歷' },
  { href: '/practice/', label: '專業實踐' },
  { href: '/about/', label: '關於我' }
];
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071b31" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-wrap shell">
        <a class="brand" href="/" aria-label="回到首頁">
          <strong>Shirley CHEN</strong><span>陳思琦</span>
        </a>
        <nav class="main-nav" aria-label="主要導覽">
          {nav.map((item) => (
            <a class:list={[path === item.href && 'active']} href={item.href}>{item.label}</a>
          ))}
        </nav>
        <a class="linkedin-link" href={site.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">in</a>
        <button class="menu-button" aria-label="開啟選單" aria-expanded="false">☰</button>
      </div>
      <div class="mobile-nav shell" hidden>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </header>
    <main><slot /></main>
    <footer class="footer">
      <div class="shell footer-grid">
        <div>
          <div class="footer-name">Shirley CHEN 陳思琦</div>
          <p>企業傳訊 · 媒體關係 · 財經公關</p>
        </div>
        <div>
          <strong>聯絡方式</strong>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <span>香港</span>
        </div>
        <div>
          <strong>專業連結</strong>
          <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        </div>
        <div class="footer-copy">© {new Date().getFullYear()} Shirley CHEN 陳思琦</div>
      </div>
    </footer>
    <script is:inline>
      const menuButton = document.querySelector('.menu-button');
      const mobileNav = document.querySelector('.mobile-nav');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        if (mobileNav) mobileNav.hidden = open;
      });
    </script>
  </body>
</html>
